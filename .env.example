# Twitch OAuth
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
TWITCH_BROADCASTER_REDIRECT_URI=http://localhost:3000/api/auth/twitch/broadcaster/callback
TWITCH_BOT_REDIRECT_URI=http://localhost:3000/api/auth/twitch/bot/callback
TWITCH_BROADCASTER_ID=your_broadcaster_id
TWITCH_BOT_USER_ID=your_bot_user_id

# Broadcaster and Bot Tokens (store securely, rotate regularly)
TWITCH_BROADCASTER_ACCESS_TOKEN=
TWITCH_BROADCASTER_REFRESH_TOKEN=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=

# Security
JWT_SECRET=generate_a_secure_random_string_here
ENCRYPTION_KEY=generate_another_secure_random_string_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tofu_alert?schema=public

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# S3-Compatible Storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=tofu-alert-uploads
CDN_BASE_URL=https://your-cdn.cloudfront.net

# Moderation Services
WHISPER_MODEL_PATH=/models/whisper-small
VLLM_ENDPOINT=http://localhost:8000/v1
OPENAI_API_KEY=your_openai_api_key_for_llm_moderation

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# EventSub
EVENTSUB_SECRET=generate_a_webhook_secret_here
EVENTSUB_CALLBACK_URL=https://your-domain.com/api/webhooks/eventsub

# WebSocket Server
WS_PORT=3001
